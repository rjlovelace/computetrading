# Where data is stored. The default is a local file that needs no setup.
DATABASE_URL=sqlite:///ctrade.db
# Or Postgres, after starting it with `docker compose up -d`:
# DATABASE_URL=postgresql+psycopg://ctrade:ctrade@localhost:5432/ctrade

# Lets the `web` agent read the Silicon Data index pages (console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: more Ornn history
# ORNN_API_KEY=
